node_modules/
__pycache__/
*.py[cod]
.next/
.next-*/
.next.prev/
# 最終手段のビルドミラー（通常は %LOCALAPPDATA%\leafcode-pi\build\ 配下）
.build-mirror/
.env*.local
*.log
.DS_Store
Thumbs.db
desktop.ini
tmp/
web/playwright-report/
web/.playwright/
web/coverage/
web/tsconfig.tsbuildinfo
.leafcode-pi/

# Native launcher: the entry-point exe itself (LeafCodePi.exe) is tracked
# at the repo root; scripts/build-launcher.bat regenerates it from
# scripts/launcher/Launcher.cs. Only the build artifacts are ignored.
LeafCodePi.exe.old
scripts/launcher/*.exe
scripts/launcher/*.ico
scripts/launcher/*.obj
scripts/launcher/*.pdb

# ローカル専用メモ（共有しない）
/MEMORY.md
/LESSONS.md
/context.md

# WebUI/拡張のローカル実行状態（goal-loop state, permission-gate 設定等）
/.pi/
extensions/leafcode-tts/server/local.rocm.json
