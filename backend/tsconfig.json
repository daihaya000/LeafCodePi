{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@shared/*": ["../shared/*.ts"]
    }
  },
  "include": ["core/*.d.mts", "core/*.typecheck.ts"]
}
