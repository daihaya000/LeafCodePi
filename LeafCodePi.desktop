[Desktop Entry]
Version=1.0
Type=Application
Name=LeafCodePi
Comment=LeafCodePi Pi Coding Agent
# %k resolves to this desktop file, so the repository checkout can move.
Exec=/bin/sh -c "dirname --zero -- \"%k\" | xargs --null --no-run-if-empty -I{} sh \"{}/scripts/launch-linux.sh\""
Icon=leafcode-pi
Terminal=false
StartupNotify=false
Categories=Development;
Keywords=Pi;Coding;Agent;
