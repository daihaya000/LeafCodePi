{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../scripts/start-dev-gateway.mjs",
    "build": "node ../scripts/build-web.mjs",
    "start": "node ../scripts/start-production-gateway.mjs",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.spa.json",
    "check:browser": "node ../scripts/production-boundary.mjs --browser",
    "check:gateway": "node ../scripts/production-boundary.mjs --gateway",
    "test": "vitest run",
    "dev:spa": "node ../scripts/start-dev-gateway.mjs",
    "build:spa": "vite build --config vite.config.ts",
    "preview:spa": "vite preview --config vite.config.ts",
    "typecheck:spa": "tsc -p tsconfig.spa.json",
    "check:production": "node ../scripts/production-boundary.mjs",
    "test:spa:browser": "node ../scripts/spa-browser-contract.mjs",
    "test:spa:secrets": "node --test ../scripts/spa-secret-canary.test.mjs && vitest run src/spa/build-boundary.test.ts --maxWorkers=1"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "happy-dom": "^20.11.6",
    "playwright": "1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23"
    }
  }
}
