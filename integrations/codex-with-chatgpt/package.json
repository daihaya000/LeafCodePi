{
  "name": "leafcode-pi-c2c-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only ChatGPT advisory bridge for LeafCodePi",
  "type": "module",
  "license": "MIT",
  "bin": {
    "c2c": "./bin/c2c.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "commander": "14.0.3",
    "express": "5.2.1",
    "ignore": "7.0.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
