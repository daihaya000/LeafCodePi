{
  "version": "1.0.0",
  "description": "Reverse-skill bootstrap manifest — capability definitions for on-demand toolchain installation",
  "capabilities": [
    {
      "id": "jadx",
      "name": "JADX",
      "purpose": "APK/DEX to Java decompiler",
      "auto_install": true,
      "commands": {
        "linux": "curl -L https://github.com/skylot/jadx/releases/latest/download/jadx-x.x.x.zip -o /tmp/jadx.zip && unzip -o /tmp/jadx.zip -d ~/.local/share/jadx && ln -sf ~/.local/share/jadx/bin/jadx ~/.local/bin/jadx",
        "macos": "brew install jadx",
        "windows": "scoop install jadx"
      }
    },
    {
      "id": "apktool",
      "name": "Apktool",
      "purpose": "APK decode/rebuild",
      "auto_install": true,
      "commands": {
        "linux": "curl -L https://bitbucket.org/iBotPeaches/apktool/downloads/apktool_2.9.3.jar -o ~/.local/bin/apktool.jar",
        "macos": "brew install apktool",
        "windows": "scoop install apktool"
      }
    },
    {
      "id": "frida",
      "name": "Frida",
      "purpose": "Dynamic instrumentation / hooking",
      "auto_install": true,
      "commands": {
        "all": "pip install frida-tools frida"
      }
    },
    {
      "id": "adb",
      "name": "ADB",
      "purpose": "Android Debug Bridge",
      "auto_install": true,
      "commands": {
        "linux": "sudo apt install -y adb",
        "macos": "brew install --cask android-platform-tools",
        "windows": "scoop install adb"
      }
    },
    {
      "id": "radare2",
      "name": "radare2",
      "purpose": "CLI binary analysis / disassembly / patch",
      "auto_install": true,
      "commands": {
        "linux": "git clone https://github.com/radareorg/radare2 /tmp/r2 && cd /tmp/r2 && sys/install.sh",
        "macos": "brew install radare2",
        "windows": "scoop install radare2"
      }
    },
    {
      "id": "ghidra",
      "name": "Ghidra",
      "purpose": "NSA reverse engineering suite",
      "auto_install": false,
      "commands": {
        "linux": "Download from https://ghidra-sre.org/",
        "macos": "brew install --cask ghidra",
        "windows": "Download from https://ghidra-sre.org/"
      }
    },
    {
      "id": "ida-pro",
      "name": "IDA Pro",
      "purpose": "Commercial disassembler (requires license)",
      "auto_install": false,
      "commands": {
        "all": "Manual install from https://hex-rays.com/"
      }
    },
    {
      "id": "pwntools",
      "name": "pwntools",
      "purpose": "CTF/pwn exploit development",
      "auto_install": true,
      "commands": {
        "all": "pip install pwntools"
      }
    },
    {
      "id": "gdb-gef",
      "name": "GDB + GEF",
      "purpose": "Debugging with GEF extension",
      "auto_install": true,
      "commands": {
        "linux": "sudo apt install -y gdb && bash -c \"$(curl -fsSL https://gef.blah.cat/sh)\"",
        "macos": "brew install gdb && bash -c \"$(curl -fsSL https://gef.blah.cat/sh)\"",
        "windows": "Use WSL2 + apt"
      }
    },
    {
      "id": "ropgadget",
      "name": "ROPgadget",
      "purpose": "ROP gadget finder",
      "auto_install": true,
      "commands": {
        "all": "pip install ROPgadget"
      }
    },
    {
      "id": "nmap",
      "name": "Nmap",
      "purpose": "Network scanner",
      "auto_install": true,
      "commands": {
        "linux": "sudo apt install -y nmap",
        "macos": "brew install nmap",
        "windows": "scoop install nmap"
      }
    },
    {
      "id": "nuclei",
      "name": "Nuclei",
      "purpose": "Template-based vulnerability scanner",
      "auto_install": true,
