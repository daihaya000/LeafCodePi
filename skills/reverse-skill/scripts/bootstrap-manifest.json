        "linux": "curl -L https://github.com/projectdiscovery/nuclei/releases/latest/download/nuclei-linux-amd64 -o ~/.local/bin/nuclei && chmod +x ~/.local/bin/nuclei",
        "macos": "brew install nuclei",
        "windows": "scoop install nuclei"
      }
    },
    {
      "id": "sqlmap",
